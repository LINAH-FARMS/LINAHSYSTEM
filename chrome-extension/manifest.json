{
  "manifest_version": 3,
  "name": "LINAHSYSTEM - مراقب الصيانة",
  "version": "1.0",
  "description": "يتعرف على طلبات الصيانة في واتساب ويحفظها تلقائياً",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://cwqghiqykohefaggedjl.supabase.co/*"
  ],
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINAHSYSTEM",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
